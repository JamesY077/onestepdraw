VITE_APP_NAME=Stepframe
VITE_APP_VERSION=1.0.0
VITE_API_BASE_URL=/api/v1
VITE_API_DOCS_URL=https://aiping.cn/docs

# 本地运行默认使用项目 public/ 下的静态资源。
# 如需使用 CDN，可填写以 / 结尾的前缀，例如 https://cdn.example.com/site-assets
VITE_CDN_ASSET_BASE=

# 旧版图片 / 视频工作台的参考文件上传服务（对话功能不需要，可留空）。
VITE_UPLOAD_SERVICE_URL=
VITE_UPLOAD_SERVICE_TOKEN=
