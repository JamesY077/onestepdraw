{
  "name": "stepframe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Stepframe — 本地化 AI 创作助手，基于 AIPing 与 DeepSeek V4.1 Flash",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "serve": "node server/local/server.mjs",
    "start": "npm run build && npm run serve",
    "app": "npm run build && electron .",
    "app:run": "electron .",
    "app:pack": "npm run build && electron-builder --mac --dir",
    "app:dmg": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@sparkjsdev/spark": "^2.4.0",
    "@types/three": "^0.181.0",
    "@vueuse/core": "^15.1.0",
    "axios": "^1.15.2",
    "dompurify": "^3.5.0",
    "gifenc": "^1.0.3",
    "gsap": "^3.15.1",
    "marked": "^18.2.1",
    "mediabunny": "^1.66.2",
    "motion-v": "^2.13.0",
    "pinia": "^3.0.4",
    "three": "^0.181.2",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "jsrepo": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.9",
    "vue-tsc": "^3.2.7",
    "wait-on": "^9.0.10"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "build": {
    "appId": "com.stepframe.app",
    "productName": "Stepframe",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "skills/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Stepframe"
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "author": "Stepframe",
  "repository": {
    "type": "git",
    "url": "https://github.com/JamesY077/onestepdraw.git"
  }
}
